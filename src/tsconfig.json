{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "types": ["vite/client", "vitest/globals", "node"]
  },
  "include": ["./**/*.ts", "./**/*.tsx", "./**/*.vue", "../tests/unit/**/*.ts"],
  "exclude": ["./vite.config.mts", "./node_modules", "../deps/dist", "../deps/node_modules", "../tests/node_modules", "../tests/e2e"]
}
