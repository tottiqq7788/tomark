{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "",
    "features": ["wdio"]
  },
  "app": {
    "security": {
      "capabilities": [
        {
          "identifier": "e2e",
          "description": "Capabilities for WDIO embedded E2E builds",
          "windows": ["main"],
          "permissions": [
            "core:default",
            "core:window:allow-destroy",
            "core:window:allow-close",
            "dialog:default",
            "fs:allow-read-text-file",
            "fs:allow-read-file",
            "allow-atomic-write-text-file",
            "allow-load-markdown-document",
            "allow-save-markdown-document",
            "allow-confirm-app-exit",
            "opener:allow-open-url",
            "opener:allow-default-urls",
            "wdio:default",
            "wdio-webdriver:default"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": false
  }
}
