{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.tomark.editor.e2e",
  "build": {
    "beforeBuildCommand": "",
    "features": [
      "wdio"
    ]
  },
  "app": {
    "security": {
      "capabilities": [
        {
          "identifier": "e2e",
          "description": "Capabilities for WDIO embedded E2E builds",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:default",
            "core:window:allow-destroy",
            "core:window:allow-close",
            "core:window:allow-minimize",
            "core:window:allow-toggle-maximize",
            "core:window:allow-is-maximized",
            "core:window:allow-start-dragging",
            "dialog:default",
            "fs:allow-read-text-file",
            "fs:allow-read-file",
            "allow-atomic-write-text-file",
            "allow-atomic-write-bytes-file",
            "allow-read-export-image",
            "allow-write-document-relative-image",
            "clipboard-manager:allow-read-image",
            "allow-write-html-export-bundle",
            "allow-write-force-export-result",
            "allow-poll-force-export-job",
            "allow-load-markdown-document",
            "allow-save-markdown-document",
            "allow-confirm-app-exit",
            "opener:allow-open-url",
            "opener:allow-default-urls",
            "wdio:default",
            "wdio-webdriver:default"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": false
  }
}
