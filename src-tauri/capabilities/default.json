{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for tomark",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-start-dragging",
    "dialog:default",
    "fs:allow-read-text-file",
    "fs:allow-read-file",
    "allow-atomic-write-text-file",
    "allow-atomic-write-bytes-file",
    "allow-read-export-image",
    "allow-write-document-relative-image",
    "clipboard-manager:allow-read-image",
    "allow-write-html-export-bundle",
    "allow-poll-force-export-job",
    "allow-write-force-export-result",
    "allow-write-force-export-status",
    "allow-load-markdown-document",
    "allow-save-markdown-document",
    "allow-confirm-app-exit",
    "allow-acknowledge-open-file-listener",
    "allow-request-default-markdown-app",
    "opener:allow-open-url",
    "opener:allow-default-urls"
  ]
}
