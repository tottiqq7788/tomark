{
  "name": "tomark",
  "private": true,
  "version": "4.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config ../src/vite.config.mts",
    "build": "vue-tsc --noEmit -p ../src/tsconfig.json && vite build --config ../src/vite.config.mts",
    "preview": "vite preview --config ../src/vite.config.mts",
    "test": "cd .. && deps/node_modules/.bin/vitest run --config deps/vitest.config.ts",
    "test:watch": "cd .. && deps/node_modules/.bin/vitest --config deps/vitest.config.ts",
    "test:e2e": "cd .. && deps/node_modules/.bin/wdio run tests/e2e/wdio.browser.conf.ts",
    "test:e2e:native": "npm run tauri:e2e:build && npm run test:e2e:native:run",
    "test:e2e:native:run": "cd .. && deps/node_modules/.bin/wdio run tests/e2e/wdio.native.conf.ts",
    "test:all": "npm test && npm run test:e2e && npm run test:e2e:native",
    "sync:version": "node ./sync-version-from-git.mjs",
    "tauri": "cd .. && deps/node_modules/.bin/tauri",
    "tauri:dev": "cd .. && deps/node_modules/.bin/tauri dev --config src-tauri/tauri.conf.json",
    "tauri:build": "npm run sync:version && cd .. && deps/node_modules/.bin/tauri build --config src-tauri/tauri.conf.json",
    "tauri:e2e:build": "VITE_WDIO=1 npm run build && cd .. && deps/node_modules/.bin/tauri build --debug --config src-tauri/tauri.e2e.conf.json"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "decode-named-character-reference": "^1.3.0",
    "html2canvas": "^1.4.1",
    "mermaid": "^11.16.1",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.11",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.0",
    "prosemirror-view": "^1.42.2",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/hast": "^3.0.5",
    "@types/html2canvas": "^0.5.35",
    "@types/mdast": "^4.0.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.15.30",
    "@types/unist": "^3.0.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "@wdio/cli": "^9.30.1",
    "@wdio/local-runner": "^9.30.1",
    "@wdio/mocha-framework": "^9.30.1",
    "@wdio/spec-reporter": "^9.30.1",
    "@wdio/tauri-plugin": "^1.3.0",
    "@wdio/tauri-service": "^1.3.0",
    "expect": "^30.4.1",
    "jsdom": "^30.0.1",
    "typescript": "~5.9.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  }
}
